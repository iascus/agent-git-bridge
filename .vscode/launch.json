{
    "version": "0.2.0",
    "configurations": [
        {
            // Runs the HTTP service on 127.0.0.1:8000 under the debugger.
            // Any running bridge instance (e.g. the scheduled task) is stopped
            // automatically at startup. Afterwards: Start-ScheduledTask agent-git-bridge
            "name": "Git Bridge: serve",
            "type": "debugpy",
            "request": "launch",
            "module": "git_bridge",
            "args": [
                "--config",
                "${env:USERPROFILE}/.config/agent-git-bridge/config.yaml",
                "serve"
            ],
            "python": "${workspaceFolder}/.venv/Scripts/python.exe",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": true
        }
    ]
}
